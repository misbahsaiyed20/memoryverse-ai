APP_NAME=MemoryVerse AI
ENVIRONMENT=development

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/memoryverse

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Firebase Admin service account JSON path
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Local directory where uploaded documents are stored
UPLOAD_DIR=./uploads

# Gemini AI configuration
# Add your own API key locally in .env file
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Vector database storage
CHROMA_DB_PATH=./chromadb