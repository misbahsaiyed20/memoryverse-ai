APP_NAME=MemoryVerse AI
ENVIRONMENT=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memoryverse

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Path to the Firebase Admin service account JSON (download from
# Firebase Console → Project Settings → Service Accounts)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Local directory where uploaded documents are stored (Sprint 3)
UPLOAD_DIR=./uploads

# Gemini extraction (Sprint 6) — get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6JRghz14mf8pw6IWMQccSeRG_4txfDmbd1p2D9TkB395g
GEMINI_MODEL=gemini-2.5-flash

# Vector storage (Sprint 7) — persistent local ChromaDB path
CHROMA_DB_PATH=./chromadb
