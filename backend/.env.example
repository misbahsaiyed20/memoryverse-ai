APP_NAME=MemoryVerse AI
ENVIRONMENT=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/memoryverse

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Path to the Firebase Admin service account JSON (download from
# Firebase Console → Project Settings → Service Accounts)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Local directory where uploaded documents are stored (Sprint 3)
UPLOAD_DIR=./uploads

# Gemini extraction (Sprint 6) — get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Vertex AI mode — alternative to GEMINI_API_KEY for accounts stuck with
# AQ.-prefixed keys that the Generative Language API rejects. Requires a
# GCP project with Vertex AI enabled and either `gcloud auth
# application-default login` run locally, or GOOGLE_APPLICATION_CREDENTIALS
# pointing to a service account JSON. Leave GEMINI_USE_VERTEXAI unset/false
# to keep using GEMINI_API_KEY above.
GEMINI_USE_VERTEXAI=false
GCP_PROJECT=
GCP_LOCATION=us-central1

# Vector storage (Sprint 7) — persistent local ChromaDB path
CHROMA_DB_PATH=./chromadb
